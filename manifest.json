{
  "manifest_version": 3,
  "name": "RuNotion",
  "version": "1.0",
  "description": "Переводит интерфейс Notion на русский язык",

  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "action": {
    "default_title": "RuNotion",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "notion-ru-translator@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },

  "host_permissions": [
    "https://www.notion.so/*",
    "https://*.notion.so/*",
    "https://*.notion.site/*",
    "https://www.notion.com/*",
    "https://*.notion.com/*",
    "https://www.notion.com/",
    "https://app.notion.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.notion.so/*",
        "https://*.notion.so/*",
        "https://*.notion.site/*",
        "https://app.notion.com/*",
        "https://www.notion.com/*",
        "https://*.notion.com/*",
        "https://www.notion.com/"
      ],
      "js": [
        "dictionary.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
} 